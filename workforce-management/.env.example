# ===================================================================
# AI-Powered Workforce Management Automation System
# Master Environment Configuration Template (.env.example)
# ===================================================================
# Copy this file to .env and configure for your target deployment.
# NEVER commit production credentials or secrets to version control.
# ===================================================================

# -------------------------------------------------------------------
# 1. Core Server & Environment
# -------------------------------------------------------------------
ENVIRONMENT=development                # development | test | staging | production
PROJECT_NAME="AI Workforce Management Automation System"
VERSION="1.0.0"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                        # json | text

# -------------------------------------------------------------------
# 2. Database (MongoDB)
# -------------------------------------------------------------------
# For local containerized / standalone MongoDB:
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=hr_automation
# For MongoDB Atlas / Production Cluster:
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Connection Pool & Timeouts:
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

# -------------------------------------------------------------------
# 3. Security, Authentication & Session
# -------------------------------------------------------------------
# Mandatory: Generate a high-entropy secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=super-secure-jwt-secret-key-for-hr-automation-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480        # 8 hours

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_GENERAL_PER_MINUTE=120

# CORS Allowed Origins (Comma-separated in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
ALLOWED_HOSTS=*                        # Comma-separated list of trusted hosts in production

# -------------------------------------------------------------------
# 4. Geofencing & Attendance
# -------------------------------------------------------------------
DEFAULT_GEOFENCE_RADIUS_METERS=500.0

# -------------------------------------------------------------------
# 5. AI Workforce Intelligence & RAG Chatbot (Phase 5 & 6)
# -------------------------------------------------------------------
LLM_PROVIDER=local                     # local | openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
EMBEDDING_PROVIDER=local_tfidf          # local_tfidf | openai
EMBEDDING_MODEL=text-embedding-3-small
CHATBOT_TEMPERATURE=0.2
CHATBOT_MAX_TOKENS=800
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.08

# -------------------------------------------------------------------
# 6. Notifications & Workflow Engine (Phase 7)
# -------------------------------------------------------------------
NOTIFICATIONS_ENABLED=true
REALTIME_NOTIFICATIONS_ENABLED=true
NOTIFICATION_POLL_INTERVAL_SECONDS=30
SCHEDULER_INTERVAL_SECONDS=300
SHIFT_REMINDER_MINUTES=60
OVERTIME_ALERT_THRESHOLD_HOURS=2
PERFORMANCE_REMINDER_DAYS=7
TRAINING_REMINDER_DAYS=3

# Email Delivery (SMTP / SendGrid / SES / Mock)
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp                    # smtp | sendgrid | ses | mock
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=notifications@workforce.ai

# -------------------------------------------------------------------
# 7. Enterprise Integration Connectors (Phase 10)
# -------------------------------------------------------------------
# Cloud Email Providers
SENDGRID_API_KEY=
SES_AWS_REGION=us-east-1
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=

# Microsoft 365 (Teams, Graph, Entra ID)
MICROSOFT_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALENDAR_ENABLED=false
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=

# Slack Ecosystem
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_DEFAULT_CHANNEL=#hr-notifications

# Google Workspace (Calendar)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ENABLED=false

# Enterprise Identity (LDAP / Active Directory)
ENTRA_ID_ENABLED=false
LDAP_AD_ENABLED=false
LDAP_SERVER_URI=ldaps://ad.innovatecorp.com:636
LDAP_BIND_DN=CN=svc_hr,OU=ServiceAccounts,DC=innovatecorp,DC=com
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=innovatecorp,DC=com

# Payroll Gateway
PAYROLL_INTEGRATION_ENABLED=false
PAYROLL_PROVIDER=generic_api           # generic_api | quickbooks | adp
PAYROLL_API_BASE_URL=https://api.payroll-gateway.com/v1
PAYROLL_API_KEY=

# ERP & HRMS (SAP S/4HANA & Oracle Cloud HCM)
SAP_ENABLED=false
SAP_BASE_URL=https://my-s4hana.sapecc.com/sap/opu/odata/sap/
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
ORACLE_HRMS_ENABLED=false
ORACLE_HRMS_BASE_URL=https://oracle-hcm.oraclecloud.com/hcmRestApi/resources/11.13.18.05/
ORACLE_HRMS_CLIENT_ID=
ORACLE_HRMS_CLIENT_SECRET=

# Biometric & Face Recognition Hardware
BIOMETRIC_ENABLED=false
BIOMETRIC_PROVIDER=zkteco_push         # zkteco_push | generic_ip
BIOMETRIC_BASE_URL=http://biometric-controller.lan:8080
BIOMETRIC_API_KEY=

# Webhook Security & Circuit Breakers
WEBHOOK_SIGNING_SECRET=super-secure-webhook-signing-secret-2026
INTEGRATION_TIMEOUT_SECONDS=10
INTEGRATION_MAX_RETRIES=3

# -------------------------------------------------------------------
# 8. Monitoring & Observability (Phase 12)
# -------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
